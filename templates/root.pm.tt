# Generated by create-sdl3-bindings.
package [% root %];

use v5.36;
use XSLoader;

our $VERSION = '[% version %]';

XSLoader::load('[% root %]', $VERSION);

require [% structBase %];
require [% pointerClass %];
[% FOREACH module IN apiModules %]require [% module %];
[% END %][% FOREACH module IN classModules %]require [% module %];
[% END %]
our @EXPORT_OK;
our %EXPORT_TAGS = (
[% FOREACH tag IN tags %]	'[% tag.name %]' => \@[% tag.module %]::EXPORT_OK,
[% END %]);

{
	no strict 'refs';
	foreach my $module ([% FOREACH module IN apiModules %]'[% module %]', [% END %]) {
		foreach my $name (@{"${module}::EXPORT_OK"}) {
			*{"[% root %]::$name"} = \&{"${module}::$name"};
			push @EXPORT_OK, $name;
		}
		push $EXPORT_TAGS{functions}->@*, @{"${module}::EXPORT_TAGS"}{functions}->@*;
		push $EXPORT_TAGS{constants}->@*, @{"${module}::EXPORT_TAGS"}{constants}->@*;
	}
	$EXPORT_TAGS{all} = \@EXPORT_OK;
}

use Exporter 'import';

1;

__END__

=encoding utf8

=head1 NAME

[% root %] - low-level binding generated from the C headers

=head1 SYNOPSIS

  use [% root %] ':all';            # everything
  use [% root %] ':video';          # one header's functions and constants
  use [% root %] qw(SDL_Init);      # single symbols

=head1 DESCRIPTION

Loads the XS code and re-exports every function and constant of the
per-header modules. Tags are available per header ([% FOREACH tag IN tags %]C<:[% tag.name %]> [% END %])
as well as C<:functions>, C<:constants> and C<:all>.

=head1 CONVENTIONS

=over

=item Strings

Every C<char *> result is a Perl string (UTF-8 both ways); undef is NULL.
Results the library hands over to the caller are freed by the binding right
after copying, so nothing has to be released from Perl. A non-const
C<char *> parameter is a writable buffer: pass a scalar sized beforehand,
e.g. C<< "\0" x 64 >>.

=item Structs

Pointers to structs and unions are objects of a class per type, see
L<[% structBase %]>. Struct arguments passed by value accept the same objects.

=item Out parameters

A pointer to a scalar or to a pointer accepts a reference to a scalar
(read before, written after the call), a L<[% pointerClass %]>, or undef for NULL.

=item Callbacks

A function pointer parameter accepts a code reference; the accompanying
C<void *userdata> parameter accepts any scalar, which the callback
receives in the same position. The holder keeping both alive is never
freed: registering callbacks repeatedly leaks a few words each time.
Callbacks must be invoked on the Perl thread.

=item Variadic functions

printf-style functions take their fixed arguments except the format
string, plus one trailing message that is printed verbatim.

=back

=cut
