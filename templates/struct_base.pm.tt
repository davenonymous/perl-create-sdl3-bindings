# Generated by create-sdl3-bindings.
package [% structBase %];

use v5.36;
use Carp qw(croak);

# Allocates a zeroed instance and sets the given fields through their accessors.
sub new ($class, %fields) {
	croak "$class is an opaque type and cannot be allocated from Perl" if !$class->can('_alloc');
	my $self = $class->_alloc;
	foreach my $name (sort keys %fields) {
		croak "$class has no field '$name'" if !$self->can($name);
		$self->$name($fields{$name});
	}
	return $self;
}

sub sizeof ($self) { return $self->_sizeof }

sub bytes ($self) { return $self->_bytes($self->_sizeof) }

1;

__END__

=encoding utf8

=head1 NAME

[% structBase %] - base class of every struct and union wrapper

=head1 DESCRIPTION

An instance is a blessed scalar reference. Objects created with C<new>
own their memory: it lives in the scalar and is freed with it. Objects
returned from C functions or from accessors of nested structs borrow
memory owned by the library or by a parent object; keep the owner alive
while using them.

=head1 METHODS

=over

=item new(%fields)

Allocates a zeroed instance and sets the given fields.

=item address

The memory address as an unsigned integer.

=item sizeof

The size of the C type in bytes.

=item bytes

A copy of the raw memory as a byte string.

=back

Every field has an accessor of the same name: called without arguments it
reads, called with one argument it writes and returns the object. Array
fields read as a list and are written from a list of exactly their length.

=cut
