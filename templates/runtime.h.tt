/* Generated by create-sdl3-bindings. Helpers shared by every generated XSUB. */
#ifndef BINDGEN_RUNTIME_H
#define BINDGEN_RUNTIME_H

#define BG_POINTER_CLASS "[% pointerClass %]"
#define BG_STRUCT_BASE   "[% structBase %]"

typedef struct bg_callback_holder {
	SV   *code;
	SV   *data;
	void *perl;
} bg_callback_holder;

static const char *bg_describe(pTHX_ SV *sv) {
	if (!SvOK(sv)) return "undef";
	if (sv_isobject(sv)) return HvNAME(SvSTASH(SvRV(sv)));
	if (SvROK(sv)) return "a reference";
	return "a plain scalar";
}

static void bg_croak_type(pTHX_ const char *ctx, const char *expected, SV *sv) {
	croak("%s: expected %s, got %s", ctx, expected, bg_describe(aTHX_ sv));
}

static IV bg_in_iv(pTHX_ SV *sv, const char *ctx) {
	if (!SvOK(sv) || SvROK(sv) || !(SvNIOK(sv) || looks_like_number(sv))) bg_croak_type(aTHX_ ctx, "an integer", sv);
	return SvIV(sv);
}

static UV bg_in_uv(pTHX_ SV *sv, const char *ctx) {
	if (!SvOK(sv) || SvROK(sv) || !(SvNIOK(sv) || looks_like_number(sv))) bg_croak_type(aTHX_ ctx, "an unsigned integer", sv);
	return SvUV(sv);
}

static NV bg_in_nv(pTHX_ SV *sv, const char *ctx) {
	if (!SvOK(sv) || SvROK(sv) || !(SvNIOK(sv) || looks_like_number(sv))) bg_croak_type(aTHX_ ctx, "a number", sv);
	return SvNV(sv);
}

static const char *bg_in_string(pTHX_ SV *sv, const char *ctx) {
	if (!SvOK(sv)) return NULL;
	if (SvROK(sv)) bg_croak_type(aTHX_ ctx, "a string or undef", sv);
	return SvPVutf8_nolen(sv);
}

/* The pointer carried by a struct or pointer object: owned memory lives in the
 * scalar's string buffer, borrowed memory is stored as an integer. */
static void *bg_object_ptr(pTHX_ SV *sv) {
	SV *inner = SvRV(sv);
	if (SvPOK(inner)) return (void *)SvPVX(inner);
	return INT2PTR(void *, SvIV(inner));
}

static int bg_is_pointer_object(pTHX_ SV *sv) {
	return sv_isobject(sv) && SvTYPE(SvRV(sv)) < SVt_PVAV && (sv_derived_from(sv, BG_STRUCT_BASE) || sv_derived_from(sv, BG_POINTER_CLASS));
}

static char *bg_in_writable_string(pTHX_ SV *sv, const char *ctx) {
	if (!SvOK(sv)) return NULL;
	if (bg_is_pointer_object(aTHX_ sv)) return (char *)bg_object_ptr(aTHX_ sv);
	if (SvROK(sv) || SvREADONLY(sv)) bg_croak_type(aTHX_ ctx, "a writable string buffer, a pointer object or undef", sv);
	return SvPV_force_nolen(sv);
}

static void *bg_in_record_ptr(pTHX_ SV *sv, const char *klass, const char *ctx) {
	if (!SvOK(sv)) return NULL;
	if (sv_isobject(sv) && (sv_derived_from(sv, klass) || sv_derived_from(sv, BG_POINTER_CLASS))) return bg_object_ptr(aTHX_ sv);
	bg_croak_type(aTHX_ ctx, klass, sv);
	return NULL;
}

static void *bg_in_record_value_ptr(pTHX_ SV *sv, const char *klass, const char *ctx) {
	void *p = bg_in_record_ptr(aTHX_ sv, klass, ctx);
	if (!p) croak("%s: expected a %s object, got undef", ctx, klass);
	return p;
}

/* void * and buffers: objects hand over their pointer, plain scalars their bytes. */
static void *bg_in_raw_ptr(pTHX_ SV *sv, const char *ctx) {
	if (!SvOK(sv)) return NULL;
	if (bg_is_pointer_object(aTHX_ sv)) return bg_object_ptr(aTHX_ sv);
	if (SvROK(sv)) bg_croak_type(aTHX_ ctx, "a pointer object, a string buffer or undef", sv);
	return (void *)SvPV_nolen(sv);
}

/* Out parameters: a reference to a plain scalar receives the value after the call. */
static SV *bg_outref_target(pTHX_ SV *sv) {
	if (SvROK(sv) && !sv_isobject(sv) && SvTYPE(SvRV(sv)) < SVt_PVAV) return SvRV(sv);
	return NULL;
}

static void *bg_outref_raw(pTHX_ SV *sv, const char *ctx) {
	if (!SvOK(sv)) return NULL;
	if (bg_is_pointer_object(aTHX_ sv)) return bg_object_ptr(aTHX_ sv);
	bg_croak_type(aTHX_ ctx, "a scalar reference, a pointer object or undef", sv);
	return NULL;
}

static SV *bg_bless_ptr(pTHX_ void *p, const char *klass) {
	return sv_bless(newRV_noinc(newSViv(PTR2IV(p))), gv_stashpv(klass, GV_ADD));
}

static SV *bg_out_record_ptr(pTHX_ void *p, const char *klass) {
	if (!p) return &PL_sv_undef;
	return bg_bless_ptr(aTHX_ p, klass);
}

static SV *bg_new_record(pTHX_ size_t size, const char *klass) {
	SV *inner = newSV(size + 1);
	SvPOK_on(inner);
	SvCUR_set(inner, size);
	Zero(SvPVX(inner), size + 1, char);
	return sv_bless(newRV_noinc(inner), gv_stashpv(klass, GV_ADD));
}

static SV *bg_out_record_copy(pTHX_ const void *p, size_t size, const char *klass) {
	SV *object = bg_new_record(aTHX_ size, klass);
	Copy(p, SvPVX(SvRV(object)), size, char);
	return object;
}

static SV *bg_out_raw_ptr(pTHX_ void *p, const char *klass) {
	return bg_out_record_ptr(aTHX_ p, klass);
}

static SV *bg_out_string(pTHX_ const char *s) {
	SV *sv;
	if (!s) return &PL_sv_undef;
	sv = newSVpv(s, 0);
	sv_utf8_decode(sv);
	return sv;
}

/* A string the caller owns: copied, then released through the library's deallocator. */
static SV *bg_out_owned_string(pTHX_ char *s, void (*release)(void *)) {
	SV *sv = bg_out_string(aTHX_ s);
	if (s) release(s);
	return sv;
}

static bg_callback_holder *bg_make_holder(pTHX_ SV *code, SV *data, const char *ctx) {
	bg_callback_holder *holder;
	if (!(SvROK(code) && SvTYPE(SvRV(code)) == SVt_PVCV)) bg_croak_type(aTHX_ ctx, "a code reference", code);
	holder       = (bg_callback_holder *)safemalloc(sizeof(*holder));
	holder->code = newSVsv(code);
	holder->data = newSVsv(data);
	holder->perl = PERL_GET_THX;
	return holder;    /* kept alive for the lifetime of the process, see README */
}

static void bg_export_constant(pTHX_ HV *stash, const char *name, SV *value) {
	if (!value) return;
	newCONSTSUB(stash, name, value);
}

/* Constants are exported with the type the compiler sees, whatever the macro expands to. */
static SV *bg_sv_from_str(pTHX_ int unused, const char *v)         { PERL_UNUSED_VAR(unused); return bg_out_string(aTHX_ v); }
static SV *bg_sv_from_nv(pTHX_ int unused, double v)               { PERL_UNUSED_VAR(unused); return newSVnv((NV)v); }
static SV *bg_sv_from_iv(pTHX_ int unused, long long v)            { PERL_UNUSED_VAR(unused); return newSViv((IV)v); }
static SV *bg_sv_from_uv(pTHX_ int unused, unsigned long long v)   { PERL_UNUSED_VAR(unused); return newSVuv((UV)v); }
static SV *bg_sv_from_bool(pTHX_ int unused, int v)                { PERL_UNUSED_VAR(unused); return newSVsv(boolSV(v)); }
static SV *bg_sv_none(pTHX_ int unused, ...)                        { PERL_UNUSED_VAR(unused); return NULL; }

#define BG_CONST_SV(x) _Generic((x), \
	char *: bg_sv_from_str, const char *: bg_sv_from_str, \
	float: bg_sv_from_nv, double: bg_sv_from_nv, long double: bg_sv_from_nv, \
	_Bool: bg_sv_from_bool, \
	char: bg_sv_from_iv, signed char: bg_sv_from_iv, short: bg_sv_from_iv, int: bg_sv_from_iv, long: bg_sv_from_iv, long long: bg_sv_from_iv, \
	unsigned char: bg_sv_from_uv, unsigned short: bg_sv_from_uv, unsigned int: bg_sv_from_uv, unsigned long: bg_sv_from_uv, unsigned long long: bg_sv_from_uv, \
	default: bg_sv_none)(aTHX_ 0, (x))

#endif
